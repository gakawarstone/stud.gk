{
  "appId": "io.github.gakawarstone.campus",
  "productName": "Stud.GK",
  "directories": { "output": "release", "buildResources": "build" },
  "asar": true,
  "files": [
    "electron/*.cjs",
    "!electron/*.test.cjs",
    "server/**/*.js",
    "!server/**/*.test.js",
    "dist/**/*",
    "build/icon.png",
    "package.json"
  ],
  "linux": {
    "target": ["AppImage"],
    "category": "Education",
    "icon": "build/icon.png",
    "executableName": "stud-gk",
    "syncDesktopName": true,
    "artifactName": "Stud.GK-${version}-linux-${arch}.${ext}",
    "desktop": { "entry": { "StartupWMClass": "Stud.GK", "Comment": "Stud.IP courses and files" } }
  },
  "appImage": { "executableArgs": [] },
  "publish": null
}
