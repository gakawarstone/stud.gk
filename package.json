{
  "name": "stud.gk",
  "version": "0.0.1",
  "description": "Stud.GK, a local read-only Stud.IP companion in Catppuccin Mocha",
  "main": "electron/main.cjs",
  "desktopName": "stud-gk.desktop",
  "homepage": "https://github.com/gakawarstone/studip",
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.js --dev",
    "build": "npm run typecheck && vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --experimental-strip-types --test server/*.test.js src/*.test.js",
    "desktop": "npm run build && env -u ELECTRON_RUN_AS_NODE electron .",
    "dist:linux": "npm run build && electron-builder --linux --x64 --publish never",
    "test:desktop": "env -u ELECTRON_RUN_AS_NODE electron scripts/desktop-smoke.cjs",
    "test:gitlab": "env -u ELECTRON_RUN_AS_NODE electron scripts/gitlab-readme-smoke.cjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json",
    "test:session": "env -u ELECTRON_RUN_AS_NODE electron scripts/session-smoke.cjs",
    "test:ui": "env -u ELECTRON_RUN_AS_NODE electron scripts/solid-ui-smoke.cjs",
    "benchmark:ui": "env -u ELECTRON_RUN_AS_NODE electron scripts/ui-benchmark.cjs"
  },
  "keywords": [],
  "author": "gakawarstone",
  "license": "ISC",
  "type": "module",
  "private": true,
  "dependencies": {
    "cheerio": "^1.2.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "highlight.js": "^11.12.0",
    "lucide-solid": "^1.61.0",
    "pdfjs-dist": "^6.4.299",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "solid-js": "^1.9.17",
    "tough-cookie": "^6.0.2",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/hast": "^3.0.5",
    "@types/node": "^24.19.2",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-solid": "^2.11.14"
  }
}
