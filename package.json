{
  "name": "studipapi",
  "version": "1.0.0",
  "description": "A local read-only Stud.IP companion in Catppuccin Mocha",
  "main": "electron/main.cjs",
  "desktopName": "campus.desktop",
  "homepage": "https://github.com/gakawarstone/studip",
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.js --dev",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test server/*.test.js",
    "desktop": "npm run build && env -u ELECTRON_RUN_AS_NODE electron .",
    "dist:linux": "npm run build && electron-builder --linux --x64 --publish never",
    "test:desktop": "env -u ELECTRON_RUN_AS_NODE electron scripts/desktop-smoke.cjs"
  },
  "keywords": [],
  "author": "gakawarstone",
  "license": "ISC",
  "type": "module",
  "private": true,
  "dependencies": {
    "cheerio": "^1.2.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "lucide-react": "^1.49.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tough-cookie": "^6.0.2"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
